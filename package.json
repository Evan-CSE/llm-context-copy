{
  "name": "import-context-copy",
  "displayName": "Import Context Copy",
  "description": "Copy code as prompt-ready context for ChatGPT, Claude or Gemini: a file plus the local files it imports, or just a function plus the functions and types it uses.",
  "version": "0.2.1",
  "publisher": "evanshareef",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Evan-CSE/llm-context-copy.git"
  },
  "bugs": {
    "url": "https://github.com/Evan-CSE/llm-context-copy/issues"
  },
  "homepage": "https://github.com/Evan-CSE/llm-context-copy#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "llm",
    "ai",
    "chatgpt",
    "claude",
    "gemini",
    "prompt",
    "context",
    "copy",
    "clipboard",
    "imports",
    "dependencies",
    "function"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "llmContextCopy.copy",
        "title": "Copy with Imports as LLM Context",
        "category": "LLM Context"
      },
      {
        "command": "llmContextCopy.copyPick",
        "title": "Copy with Imports as LLM Context (Choose Files...)",
        "category": "LLM Context"
      },
      {
        "command": "llmContextCopy.copyBlock",
        "title": "Copy Block with Dependencies as LLM Context",
        "category": "LLM Context"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "llmContextCopy.copy",
          "when": "!explorerResourceIsFolder",
          "group": "6_llmcontext@1"
        },
        {
          "command": "llmContextCopy.copyPick",
          "when": "!explorerResourceIsFolder",
          "group": "6_llmcontext@2"
        }
      ],
      "editor/context": [
        {
          "command": "llmContextCopy.copy",
          "group": "9_cutcopypaste@9"
        },
        {
          "command": "llmContextCopy.copyBlock",
          "group": "9_cutcopypaste@10"
        }
      ],
      "editor/title/context": [
        {
          "command": "llmContextCopy.copy",
          "group": "1_cutcopypaste@9"
        }
      ]
    },
    "configuration": {
      "title": "Import Context Copy",
      "properties": {
        "llmContextCopy.maxDepth": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "How many levels of local imports to follow. 0 copies only the selected files."
        },
        "llmContextCopy.maxFiles": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "description": "Maximum number of files to include."
        },
        "llmContextCopy.format": {
          "type": "string",
          "enum": [
            "markdown",
            "xml"
          ],
          "enumDescriptions": [
            "Each file as a heading plus a fenced code block.",
            "Each file wrapped in <file path=\"...\"> tags (works well with Claude)."
          ],
          "default": "markdown",
          "description": "Output format for the copied context."
        },
        "llmContextCopy.blockDepth": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "For \"Copy Block with Dependencies\": how many levels of function/type dependencies to follow."
        },
        "llmContextCopy.maxSnippets": {
          "type": "integer",
          "default": 40,
          "minimum": 1,
          "description": "For \"Copy Block with Dependencies\": maximum number of code blocks to include."
        },
        "llmContextCopy.includeImplementations": {
          "type": "boolean",
          "default": true,
          "description": "For \"Copy Block with Dependencies\": when code calls a method through an interface, also include up to 3 implementations."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@azure/msal-node": "^7.0.3"
  },
  "galleryBanner": {
    "color": "#1E1B4B",
    "theme": "dark"
  }
}
